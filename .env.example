# Copy this file to ".env" and fill in your own values.

# Port the server listens on
PORT=3000

# The public address of the website, without a trailing slash.
# Locally: http://localhost:3000   Live: https://amethia.lk
SITE_URL=http://localhost:3000

# Password for the admin panel at /admin  (use a long, unique password)
ADMIN_PASSWORD=change-this-password

# Reverse proxy in front of the shop (Caddy, Nginx…). You normally don't need to change this.
# auto = works out by itself whether Caddy/Nginx is in front (the usual setup on a VPS).
# 0    = never read the X-Forwarded-For header.
# 1, 2 = exactly that many proxies, for a host whose load balancer is on another machine.
TRUST_PROXY=auto

# Any long random text. Used to sign admin logins. Never share it.
SESSION_SECRET=replace-with-a-long-random-string

# ---- PayHere (https://www.payhere.lk) ----
# Find these in your PayHere account: Settings > Domains & Credentials
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# true = test payments on sandbox.payhere.lk, false = real payments
PAYHERE_SANDBOX=true

# Where the database file is stored
DB_PATH=./data/shop.db
